@importlollipop "./var.lcss"
@importlollipop "./basic.lcss"


.cards {
    displayG
    paddingMd
    grid3ColBox
    gapLg
    marginAuto
    marginRightAuto
    minWidth0
}

.card {
    BGW
    roundCornersMD
    paddingMd
    fontColorInk
    borderGlass
    shadowCard
    transitionCard
    minWidth0
}

.card:hover {
    liftCard
    shadowCard
}

.manifesto {
    gridFull
    BGW
}

.manifesto blockquote {
    margin0
}

.manifesto-lead {
    fontLead
    fontBold
}

.manifesto-punchline {
    fontPunchline
    fontBold
    fontColorDeepPink
}

.card:nth-child(3) {
    BGLightPurpl
}

.card:nth-child(5) {
    BGLightPink
}

.card:nth-child(3) .card-title {
    BGLightPurpl
}

.card:nth-child(4) .card-title {
    BGDeepSky
}

.card-title {
    paddingMd
    roundCornersMD
    BGDeepPink
    fontColorWhite
    displayF
    alignCenter
}

.card-title::after {
    ...afterUnit
    background-image: url("https://cdn.jsdelivr.net/gh/jdecked/twemoji@17.0.3/assets/svg/1f36d.svg");
}

.card-content {
    paddingMd
    lineH
    minWidth0
    wrapAnywhere
}

.card-content p:first-child {
    marginTop0
}

.card-content p:last-child {
    marginBottom0
}

.card-content pre {
    margin0
    paddingMd
    minWidth0
    widthFull
    maxWidthFull
    overflowXAuto
    whiteSpacePre
    touchScroll
    roundCornersSm
    BGLG
    fontColorGray
}

.card-content code {
    fontCode
}

.export-button {
    marginTopMd
    paddingSmMd
    border0
    roundCornersSm
    BGDeepPink
    fontColorWhite
    fontInherit
    fontBold
    cursorPointer
    shadowButton
}

.export-button:hover {
    hoverDim
}

.export-button:focus-visible {
    focusOutline
    focusOutlineOffset
}

.compiled-example {
    gridFull
}

.loading-guide {
    gridFull
}

.loading-grid {
    displayG
    grid2ColBox
    gapLg
    minWidth0
}

.loading-method {
    paddingMd
    roundCornersSm
    BGLG
    minWidth0
}

.loading-method h3 {
    marginTop0
}

.comparison-grid {
    displayG
    grid2ColBox
    gapLg
    minWidth0
}

.comparison-panel {
    minWidth0
}

.comparison-label {
    marginTop0
    marginBottom0
    paddingSmMd
    BGDeepPink
    fontColorWhite
    roundCornersSm
}

.code-output {
    overflowAuto
    maxOutputHeight
    widthFull
    maxWidthFull
}

@media (max-width: 768px) {
    .cards {
        grid1ColBox
    }

    .comparison-grid {
        grid1ColBox
    }

    .loading-grid {
        grid1ColBox
    }
}
