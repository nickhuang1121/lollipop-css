@lollipop {
    // Core palette
    colorInk #31283a
    colorMuted #695d73
    colorWhite #ffffff
    colorCream #fff8fb
    colorPage #fffdfd
    colorPink #ffafcc
    colorPinkSoft #ffc8dd
    colorSky #a2d2ff
    colorMint #bde0fe
    colorLilac #cdb4db
    colorCandy #ff5f9e
    colorGreen #0f8f68
    colorLine rgba(49,40,58,.14)
    colorLineStrong rgba(49,40,58,.22)
    colorShadow rgba(49,40,58,.12)
    colorCode #201628
    colorCodeSoft #2d2038

    // Spacing
    px2 2px
    px4 4px
    px6 6px
    px8 8px
    px10 10px
    px12 12px
    px14 14px
    px16 16px
    px18 18px
    px20 20px
    px24 24px
    px28 28px
    px32 32px
    px40 40px
    px48 48px
    px64 64px
    px72 72px
    maxShell 1180px
    maxMeasure 760px

    // Type
    fontBody font-family Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif
    fontMono font-family "SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace
    textInk color colorInk
    textMuted color colorMuted
    textWhite color colorWhite
    textCandy color colorCandy
    weightBold font-weight 700
    weightSemi font-weight 650
    weightMedium font-weight 560
    lineRelaxed line-height 1.65
    lineTight line-height 1.08
    letterNormal letter-spacing 0

    // Surfaces
    BGPage background linear-gradient(135deg,rgba(162,210,255,.18) 0%,rgba(255,200,221,.24) 42%,rgba(255,255,255,1) 100%)
    BGWhite background colorWhite
    BGCream background colorCream
    BGPink background colorPink
    BGSky background colorSky
    BGMint background colorMint
    BGLilac background colorLilac
    BGCode background colorCode
    borderLine border 1px solid colorLine
    borderStrong border 1px solid colorLineStrong
    borderTopLine border-top 1px solid colorLine
    shadowSoft box-shadow 0 20px 70px colorShadow
    shadowSmall box-shadow 0 8px 24px rgba(49,40,58,.10)

    // Shape
    radiusSm border-radius px6
    radiusMd border-radius px8
    radiusPill border-radius 999px

    // Layout utilities
    displayB display block
    displayF display flex
    displayG display grid
    displayInlineF display inline-flex
    alignCenter align-items center
    alignStart align-items flex-start
    justifyCenter justify-content center
    justifyBetween justify-content space-between
    placeCenter place-items center
    flexWrap flex-wrap wrap
    grid2 grid-template-columns repeat(2,minmax(0,1fr))
    grid3 grid-template-columns repeat(3,minmax(0,1fr))
    gridHero grid-template-columns minmax(0,1fr) minmax(340px,.86fr)
    gapSm gap px8
    gapMd gap px16
    gapLg gap px24
    gapXl gap px32
    gapSection gap px40
    widthFull width 100%
    maxWidthFull max-width 100%
    minWidth0 min-width 0
    wrapAnywhere overflow-wrap anywhere
    margin0 margin 0
    marginAuto margin-left auto
    marginRightAuto margin-right auto
    boxBorder box-sizing border-box

    // Controls
    border0 border 0
    cursorPointer cursor pointer
    resizeVertical resize vertical
    overflowAuto overflow auto
    whiteSpacePre white-space pre
    focusOutline outline 3px solid colorSky
    focusOutlineOffset outline-offset 3px
    transitionFast transition transform .16s ease,box-shadow .16s ease,background .16s ease,border-color .16s ease,color .16s ease
    liftSmall transform translateY(-2px)

    codeShell {
        BGCode
        textWhite
        radiusMd
        shadowSoft
        overflowAuto
    }
}
